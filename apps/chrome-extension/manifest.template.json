{
  "manifest_version": 3,
  "name": "OpenClicky Browser Companion",
  "version": "0.1.0",
  "key": "",
  "description": "Optional local bridge for the OpenClicky companion.",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [{
    "matches": ["__ALLOWED_ORIGINS__"],
    "js": ["content-script.js"],
    "run_at": "document_idle",
    "all_frames": true
  }]
}
