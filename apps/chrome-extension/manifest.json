{
  "manifest_version": 3,
  "name": "OpenClicky Browser Companion",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "key": "",
  "description": "Lets OpenClicky agents work in this browser, inside each job's own tab group.",
  "permissions": ["debugger", "tabs", "nativeMessaging", "storage", "alarms", "tabGroups", "downloads"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_icon": "icons/off-32.png" },
  "incognito": "not_allowed"
}
