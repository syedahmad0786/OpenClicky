<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>OpenClicky.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <StartupObject>OpenClicky.App.Program</StartupObject>
    <ApplicationIcon>..\..\..\assets\openclicky.ico</ApplicationIcon>
    <Version>0.2.0</Version>
    <Product>OpenClicky</Product>
    <Description>Open-source Windows screen and voice companion</Description>
    <!-- WGC/D3D + single-file publish target; matches sln x64 mapping. -->
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenClicky.Core\OpenClicky.Core.csproj" />
    <ProjectReference Include="..\OpenClicky.Capture\OpenClicky.Capture.csproj" />
    <ProjectReference Include="..\OpenClicky.Input\OpenClicky.Input.csproj" />
    <ProjectReference Include="..\OpenClicky.Overlay\OpenClicky.Overlay.csproj" />
    <ProjectReference Include="..\OpenClicky.Providers\OpenClicky.Providers.csproj" />
    <ProjectReference Include="..\OpenClicky.Agent\OpenClicky.Agent.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OpenClicky.App.SecretStore.Smoke" />
    <EmbeddedResource Include="..\..\..\assets\openclicky.ico" LogicalName="OpenClicky.App.Assets.openclicky.ico" />
    <EmbeddedResource Include="..\..\..\assets\openclicky.png" LogicalName="OpenClicky.App.Assets.openclicky.png" />
    <Compile Include="..\OpenClicky.Sandbox\SandboxForm.cs" Link="SandboxForm.cs" />
  </ItemGroup>
</Project>
