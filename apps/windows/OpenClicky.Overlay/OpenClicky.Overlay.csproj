<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenClicky.Overlay</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF only for FigureWindow (Viewport3D); everything else is WinForms/GDI+. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OpenClicky.Core\OpenClicky.Core.csproj" />
  </ItemGroup>
</Project>
