+using OpenClicky.Core.Meetings;
+namespace OpenClicky.Core.Tests.Meetings;
+public sealed class MeetingRecordsTests : IDisposable
+{
+ readonly string root = Path.Combine(Path.GetTempPath(), "meeting-" + Guid.NewGuid().ToString("N"));
+ static readonly DateTimeOffset At = DateTimeOffset.Parse("2026-10-28T00:00:00Z");
+ static TranscriptSegment Seg(string id = "seg", string text = "ACTION: Review fixture") => new(id, TimeSpan.Zero, TimeSpan.FromSeconds(2), text);
+ static MeetingSession Session(params TranscriptSegment[] segments) => new("session", "Fixture", At, segments: segments);
+ MeetingStore Store() => new(Path.Combine(root, "fixture.db"));
+ public void Dispose() { if (Directory.Exists(root)) Directory.Delete(root, true); }
+ [Fact] public void ConsentRequired() {
+ Assert.Throws<ArgumentException>(() => new MeetingSession("s", "t", At, state: MeetingState.Recording));
+ Assert.Throws<ArgumentException>(() => Session().StartRecording(new(At, "")));
+ Assert.Equal(MeetingState.Recording, Session().StartRecording(new(At, "Synthetic source")).State); }
+ [Fact] public void InvalidInputRejected() {
+ Assert.Throws<ArgumentException>(() => Session(Seg(), Seg()));
+ Assert.Throws<ArgumentException>(() => Session(Seg("../bad")));
+ Assert.Throws<ArgumentException>(() => Session(new TranscriptSegment("s", TimeSpan.FromSeconds(-1), TimeSpan.Zero, "text")));
+ Assert.Throws<ArgumentException>(() => Session(new TranscriptSegment("s", TimeSpan.Zero, TimeSpan.Zero, "text")));
+ Assert.Throws<ArgumentException>(() => Session(Seg(text: new string('a',16001))));
+ Assert.Throws<ArgumentException>(() => new MeetingSession("s", new string('a',501), At));
+ Assert.Throws<ArgumentException>(() => new MeetingSession("s", "t", At, At)); }
+ [Fact] public void ReferencesAreSameSessionExistingAndVerbatim() {
+ foreach(var note in new[] { new MeetingNote("n","other","seg","text",false), new("n","session","missing","text",false), new("n","session","seg","Invented owner",true) })
+ Assert.Throws<ArgumentException>(() => new MeetingSession("session","t",At,segments:new[]{Seg()},notes:new[]{note})); }
+ [Fact] public void ExtractionDefensiveDeterministicAndSourceDeletionCascades() {
+ var list = new List<TranscriptSegment>{Seg(),Seg("b","No decision inferred")};
+ var session = new MeetingSession("session","t",At,segments:list); list.Clear();
+ var extracted = session.ExtractNotes(); Assert.Equal(2,session.Segments.Count);
+ Assert.Equal(extracted.Notes,extracted.ExtractNotes().Notes);
+ Assert.True(extracted.Notes[0].IsAction); Assert.False(extracted.Notes[1].IsAction);
+ Assert.Single(extracted.DeleteSource("seg").Notes); }
+ [Fact] public void ReopenSearchDelete() {
+ Store().Save(Session(Seg()).ExtractNotes()); var store=Store();
+ Assert.Single(store.Get("session")!.Notes); Assert.Single(store.Search("Review"));
+ Assert.Empty(store.Search("%")); Assert.Throws<ArgumentException>(()=>store.Search(""));
+ Assert.Throws<ArgumentOutOfRangeException>(()=>store.Search("x",101));
+ Assert.True(store.Delete("session")); Assert.Null(Store().Get("session")); }
+ [Fact] public void Retention() {
+ var store=Store(); store.Save(new("old","old",At,At.AddDays(1))); store.Save(Session());
+ Assert.Equal(0,store.PurgeExpired(At)); Assert.Equal(1,store.PurgeExpired(At.AddDays(1))); Assert.NotNull(store.Get("session")); }
+ [Fact] public void SqliteFailurePreservesPreviousSnapshot() {
+ var store=Store(); store.Save(Session(Seg()));
+ using var c = new Microsoft.Data.Sqlite.SqliteConnection($"Data Source={Path.Combine(root,"fixture.db")};Pooling=False"); c.Open();
+ using var cmd=c.CreateCommand(); cmd.CommandText="CREATE TRIGGER reject_meeting_update BEFORE UPDATE ON meeting_records BEGIN SELECT RAISE(ABORT, 'fixture failure'); END;"; cmd.ExecuteNonQuery();
+ Assert.Throws<Microsoft.Data.Sqlite.SqliteException>(()=>store.Save(Session(Seg("replacement")))); Assert.Equal("seg",store.Get("session")!.Segments[0].Id); }
+ [Fact] public void ExportEscapesAndLinksSources() {
+ var s=Session(Seg(text:"<script>x</script> [link](javascript:x)\n# title")).ExtractNotes();
+ var md=MeetingExport.Markdown(s,At); Assert.Contains("Extractive",md); Assert.Contains("#segment-seg",md);
+ Assert.DoesNotContain("<script>",md); Assert.DoesNotContain("[link](javascript:",md); Assert.Contains(At.ToString("O"),md);
+ using var j=System.Text.Json.JsonDocument.Parse(MeetingExport.Json(s,At)); Assert.Equal(1,j.RootElement.GetProperty("schemaVersion").GetInt32()); }
+}
+
+
+
+public sealed class MeetingEdgeTests
+{
+ static readonly DateTimeOffset At = DateTimeOffset.Parse("2026-10-28T00:00:00Z");
+ [Fact] public void SearchFindsUnicodeAndQuotedSourceText() {
+ var root=Path.Combine(Path.GetTempPath(),"meeting-edge-"+Guid.NewGuid().ToString("N"));
+ try { var store=new MeetingStore(Path.Combine(root,"fixture.db"));
+ store.Save(new("s","fixture",At,segments:new[]{new TranscriptSegment("a",TimeSpan.Zero,TimeSpan.FromSeconds(1),"اردو \"quoted\" source")}));
+ Assert.Single(store.Search("اردو")); Assert.Single(store.Search("\"quoted\""));
+ } finally { if(Directory.Exists(root)) Directory.Delete(root,true); }
+ }
+ [Fact] public void RejectsInvalidLifecycleAndOverlongRanges() {
+ Assert.Throws<ArgumentException>(()=>new MeetingSession("s","t",At,consent:new(At.AddSeconds(-1),"fixture")));
+ Assert.Throws<ArgumentException>(()=>new MeetingSession("s","t",At,state:(MeetingState)999));
+ Assert.Throws<ArgumentException>(()=>new MeetingSession("s","t",At,segments:new[]{new TranscriptSegment("a",TimeSpan.Zero,TimeSpan.FromDays(8),"x")}));
+ var recording=new MeetingSession("s","t",At).StartRecording(new(At,"fixture"));
+ Assert.Throws<InvalidOperationException>(()=>recording.StartRecording(new(At,"fixture")));
+ }
+ [Fact] public void RejectsUnboundedSequencesAndDuplicateNotes() {
+ var seg=new TranscriptSegment("a",TimeSpan.Zero,TimeSpan.FromSeconds(1),"x");
+ Assert.Throws<ArgumentException>(()=>new MeetingSession("s","t",At,segments:Enumerable.Repeat(seg,10001)));
+ var note=new MeetingNote("n","s","a","x",false);
+ Assert.Throws<ArgumentException>(()=>new MeetingSession("s","t",At,segments:new[]{seg},notes:new[]{note,note}));
+ }
+}
