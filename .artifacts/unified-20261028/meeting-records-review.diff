+using System.Net;
+using System.Text;
+using System.Text.Json;
+namespace OpenClicky.Core.Meetings;
+public static class MeetingExport
+{
+ public static string Json(MeetingSession session,DateTimeOffset exportedAt) {
+ ArgumentNullException.ThrowIfNull(session);
+ return JsonSerializer.Serialize(new {schemaVersion=1, exportedAt, notice="Extractive notes and action candidates, not verified commitments", session},new JsonSerializerOptions{WriteIndented=true});
+ }
+ private static string Escape(string text) {
+ var s=WebUtility.HtmlEncode(text); var b=new StringBuilder();
+ foreach(var c in s) { if("\\`*_{}[]()#+-.!|>~".Contains(c)) b.Append('\\'); if(c=='\r') continue; if(c=='\n') b.Append("<br />"); else b.Append(c); }
+ return b.ToString();
+ }
+ public static string Markdown(MeetingSession session,DateTimeOffset exportedAt) {
+ ArgumentNullException.ThrowIfNull(session);
+ var b=new StringBuilder().AppendLine("# "+Escape(session.Title)).AppendLine().AppendLine("Exported: "+exportedAt.ToString("O")).AppendLine("Session: "+session.Id).AppendLine("Extractive notes and action candidates only. No inferred speakers, decisions, owners or due dates.").AppendLine();
+ foreach(var s in session.Segments) b.AppendLine($"<a id=\"segment-{s.Id}\"></a>").AppendLine($"[{s.Start:c} - {s.End:c}] {Escape(s.Text)}").AppendLine();
+ b.AppendLine("## Extractive notes");
+ foreach(var n in session.Notes) b.AppendLine($"- {(n.IsAction ? "Action candidate" : "Extract")}: {Escape(n.Text)} [source](#segment-{n.SegmentId})");
+ return b.ToString();
+ }
+}
