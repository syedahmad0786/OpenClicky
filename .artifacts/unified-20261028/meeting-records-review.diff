+namespace OpenClicky.Core.Meetings;
+public enum MeetingState { Draft, Recording, Completed }
+public sealed record MeetingConsent(DateTimeOffset GrantedAt, string Sources);
+public sealed record TranscriptSegment(string Id, TimeSpan Start, TimeSpan End, string Text);
+public sealed record MeetingNote(string Id, string SessionId, string SegmentId, string Text, bool IsAction);
+/// <summary>Immutable snapshot; notes are extracts, not verified commitments.</summary>
+public sealed class MeetingSession
+{
+ public string Id { get; }
+ public string Title { get; }
+ public DateTimeOffset CreatedAt { get; }
+ public DateTimeOffset? ExpiresAt { get; }
+ public MeetingState State { get; }
+ public MeetingConsent? Consent { get; }
+ public IReadOnlyList<TranscriptSegment> Segments { get; }
+ public IReadOnlyList<MeetingNote> Notes { get; }
+ public MeetingSession(string id, string title, DateTimeOffset createdAt, DateTimeOffset? expiresAt = null,
+ MeetingState state = MeetingState.Draft, MeetingConsent? consent = null,
+ IEnumerable<TranscriptSegment>? segments = null, IEnumerable<MeetingNote>? notes = null)
+ {
+ ValidateId(id); ValidateText(title,500);
+ if (!Enum.IsDefined(state) || expiresAt <= createdAt) throw new ArgumentException("Invalid state or retention time.");
+ if (state == MeetingState.Recording && consent is null) throw new ArgumentException("Recording requires explicit consent.");
+ if (consent is not null) { ValidateText(consent.Sources,2000); if(consent.GrantedAt < createdAt) throw new ArgumentException("Consent predates session."); }
+ var ss = (segments ?? []).Take(10001).ToArray(); var ns = (notes ?? []).Take(10001).ToArray();
+ if(ss.Length>10000 || ns.Length>10000) throw new ArgumentException("Snapshot exceeds bounds.");
+ var byId = new Dictionary<string,TranscriptSegment>(StringComparer.Ordinal);
+ foreach(var s in ss) {
+ if(s is null) throw new ArgumentException("Null segment."); ValidateId(s.Id); ValidateText(s.Text,16000);
+ if(s.Start<TimeSpan.Zero || s.End<=s.Start || s.End>TimeSpan.FromDays(7) || !byId.TryAdd(s.Id,s)) throw new ArgumentException("Invalid or duplicate segment.");
+ }
+ var ids = new HashSet<string>(StringComparer.Ordinal);
+ foreach(var n in ns) {
+ if(n is null) throw new ArgumentException("Null note."); ValidateId(n.Id);
+ if(!ids.Add(n.Id) || n.SessionId!=id || !byId.TryGetValue(n.SegmentId,out var s) || n.Text!=s.Text || n.IsAction!=IsActionText(n.Text)) throw new ArgumentException("Notes require same-session verbatim source and literal action marker.");
+ }
+ Id=id; Title=title; CreatedAt=createdAt; ExpiresAt=expiresAt; State=state; Consent=consent;
+ Segments=Array.AsReadOnly(ss); Notes=Array.AsReadOnly(ns);
+ }
+ internal static void ValidateId(string id) {
+ if(string.IsNullOrEmpty(id) || id.Length>100 || id.Any(c=>!(char.IsAsciiLetterOrDigit(c)||c=='-'||c=='_'))) throw new ArgumentException("Invalid identifier.");
+ }
+ internal static void ValidateText(string text,int max) {
+ if(string.IsNullOrWhiteSpace(text)||text.Length>max||text.Contains('\0')) throw new ArgumentException("Invalid or oversized text.");
+ }
+ private static bool IsActionText(string text)=>text.TrimStart().StartsWith("ACTION:",StringComparison.OrdinalIgnoreCase);
+ public MeetingSession StartRecording(MeetingConsent consent) {
+ ArgumentNullException.ThrowIfNull(consent);
+ if(State!=MeetingState.Draft) throw new InvalidOperationException("Only drafts can start recording.");
+ return new(Id,Title,CreatedAt,ExpiresAt,MeetingState.Recording,consent,Segments,Notes);
+ }
+ public MeetingSession ExtractNotes()=>new(Id,Title,CreatedAt,ExpiresAt,State,Consent,Segments,
+ Segments.Select((s,i)=>new MeetingNote("extract-"+i,Id,s.Id,s.Text,IsActionText(s.Text))));
+ public MeetingSession DeleteSource(string segmentId) {
+ ValidateId(segmentId);
+ return new(Id,Title,CreatedAt,ExpiresAt,State,Consent,Segments.Where(s=>s.Id!=segmentId),Notes.Where(n=>n.SegmentId!=segmentId));
+ }
+}
