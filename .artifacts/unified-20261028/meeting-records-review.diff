+using Microsoft.Data.Sqlite;
+using System.Text.Json;
+namespace OpenClicky.Core.Meetings;
+/// <summary>Transactional local snapshots; no held connection or hardware access.</summary>
+public sealed class MeetingStore
+{
+ private readonly string databasePath;
+ public MeetingStore(string databasePath) { ArgumentException.ThrowIfNullOrWhiteSpace(databasePath); this.databasePath=Path.GetFullPath(databasePath); }
+ private SqliteConnection Open() {
+ var c=LocalSqliteStore.Open(databasePath);
+ try { using var cmd=c.CreateCommand(); cmd.CommandText="CREATE TABLE IF NOT EXISTS meeting_records(id TEXT PRIMARY KEY, title TEXT NOT NULL, content TEXT NOT NULL, expires_at INTEGER NULL);"; cmd.ExecuteNonQuery(); return c; }
+ catch { c.Dispose(); throw; }
+ }
+ private sealed record Snapshot(string Id,string Title,DateTimeOffset CreatedAt,DateTimeOffset? ExpiresAt,MeetingState State,MeetingConsent? Consent,TranscriptSegment[] Segments,MeetingNote[] Notes);
+ private static string Encode(MeetingSession s)=>JsonSerializer.Serialize(new Snapshot(s.Id,s.Title,s.CreatedAt,s.ExpiresAt,s.State,s.Consent,s.Segments.ToArray(),s.Notes.ToArray()));
+ private static MeetingSession Decode(string json) {
+ var s=JsonSerializer.Deserialize<Snapshot>(json) ?? throw new InvalidDataException("Invalid meeting snapshot.");
+ return new(s.Id,s.Title,s.CreatedAt,s.ExpiresAt,s.State,s.Consent,s.Segments,s.Notes);
+ }
+ public void Save(MeetingSession session) {
+ ArgumentNullException.ThrowIfNull(session); var json=Encode(session);
+ using var c=Open(); using var tx=c.BeginTransaction(); using var cmd=c.CreateCommand(); cmd.Transaction=tx;
+ cmd.CommandText="INSERT INTO meeting_records(id,title,content,expires_at) VALUES($id,$title,$content,$expiry) ON CONFLICT(id) DO UPDATE SET title=excluded.title,content=excluded.content,expires_at=excluded.expires_at";
+ cmd.Parameters.AddWithValue("$id",session.Id); cmd.Parameters.AddWithValue("$title",session.Title); cmd.Parameters.AddWithValue("$content",json);
+ cmd.Parameters.AddWithValue("$expiry",session.ExpiresAt is {} at ? at.UtcTicks : DBNull.Value); cmd.ExecuteNonQuery(); tx.Commit();
+ }
+ public MeetingSession? Get(string id) {
+ MeetingSession.ValidateId(id); using var c=Open(); using var cmd=c.CreateCommand(); cmd.CommandText="SELECT content FROM meeting_records WHERE id=$id"; cmd.Parameters.AddWithValue("$id",id);
+ return cmd.ExecuteScalar() is string json ? Decode(json) : null;
+ }
+ public IReadOnlyList<MeetingSession> Search(string query,int limit=50) {
+ MeetingSession.ValidateText(query,500); if(limit<1||limit>100) throw new ArgumentOutOfRangeException(nameof(limit));
+ using var c=Open(); using var cmd=c.CreateCommand();
+ cmd.CommandText="SELECT content FROM meeting_records WHERE instr(lower(title),lower($query))>0 OR EXISTS(SELECT 1 FROM json_each(meeting_records.content, '$.Segments') AS segment WHERE instr(lower(json_extract(segment.value, '$.Text')),lower($query))>0) ORDER BY id LIMIT $limit";
+ cmd.Parameters.AddWithValue("$query",query); cmd.Parameters.AddWithValue("$limit",limit);
+ using var r=cmd.ExecuteReader(); var results=new List<MeetingSession>(); while(r.Read()) results.Add(Decode(r.GetString(0))); return results.AsReadOnly();
+ }
+ public bool Delete(string id) {
+ MeetingSession.ValidateId(id); using var c=Open(); using var cmd=c.CreateCommand(); cmd.CommandText="DELETE FROM meeting_records WHERE id=$id"; cmd.Parameters.AddWithValue("$id",id); return cmd.ExecuteNonQuery()>0;
+ }
+ public int PurgeExpired(DateTimeOffset now) {
+ using var c=Open(); using var cmd=c.CreateCommand(); cmd.CommandText="DELETE FROM meeting_records WHERE expires_at IS NOT NULL AND expires_at<=$now"; cmd.Parameters.AddWithValue("$now",now.UtcTicks); return cmd.ExecuteNonQuery();
+ }
+}
+
