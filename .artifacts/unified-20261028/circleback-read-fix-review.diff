+    private static Uri? ParseNext(Uri endpoint, string header)
+    {
+        if (header.Length > 8192) throw Error(CirclebackErrorKind.UnsafeEndpoint);
+        int position = 0;
+        Uri? next = null;
+        void Whitespace() { while (position < header.Length && header[position] is ' ' or '\t') position++; }
+        string Token()
+        {
+            int start = position;
+            while (position < header.Length && IsToken(header[position])) position++;
+            if (start == position) throw Error(CirclebackErrorKind.UnsafeEndpoint);
+            return header[start..position];
+        }
+        while (position < header.Length)
+        {
+            Whitespace();
+            if (position >= header.Length || header[position++] != '<') throw Error(CirclebackErrorKind.UnsafeEndpoint);
+            int start = position;
+            while (position < header.Length && header[position] != '>') position++;
+            if (position == header.Length) throw Error(CirclebackErrorKind.UnsafeEndpoint);
+            string target = header[start..position++];
+            bool isNext = false, hasRel = false;
+            Whitespace();
+            while (position < header.Length && header[position] == ';')
+            {
+                position++;
+                Whitespace();
+                string name = Token();
+                Whitespace();
+                string value = "";
+                if (position < header.Length && header[position] == '=')
+                {
+                    position++;
+                    Whitespace();
+                    if (position < header.Length && header[position] == '"')
+                    {
+                        position++;
+                        var text = new StringBuilder();
+                        while (position < header.Length && header[position] != '"')
+                        {
+                            char c = header[position++];
+                            if (c == '\\')
+                            {
+                                if (position == header.Length) throw Error(CirclebackErrorKind.UnsafeEndpoint);
+                                c = header[position++];
+                            }
+                            if (char.IsControl(c) && c != '\t') throw Error(CirclebackErrorKind.UnsafeEndpoint);
+                            text.Append(c);
+                        }
+                        if (position == header.Length) throw Error(CirclebackErrorKind.UnsafeEndpoint);
+                        position++;
+                        value = text.ToString();
+                    }
+                    else value = Token();
+                }
+                if (name.Equals("rel", StringComparison.OrdinalIgnoreCase))
+                {
+                    if (hasRel || value.Length == 0) throw Error(CirclebackErrorKind.UnsafeEndpoint);
+                    hasRel = true;
+                    isNext = value.Split(' ', StringSplitOptions.RemoveEmptyEntries).Contains("next", StringComparer.OrdinalIgnoreCase);
