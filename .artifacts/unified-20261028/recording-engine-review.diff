+using System.Diagnostics;
+using System.Globalization;
+namespace OpenClicky.Recording;
+public sealed class FfmpegRecorder
+{
+ readonly string _ffmpeg; readonly string _root;
+ public FfmpegRecorder(string ffmpegPath,string outputRoot)
+ {
+  if(!Path.IsPathFullyQualified(ffmpegPath))throw new ArgumentException("Supply absolute ffmpeg executable path.");
+  ValidateRoot(outputRoot); _ffmpeg=ffmpegPath;_root=Path.GetFullPath(outputRoot);
+ }
+ static void ValidateRoot(string root)
+ {
+  if(!Path.IsPathFullyQualified(root)||root.StartsWith(@"\\")||root.IndexOf(':',2)>=0||root.IndexOfAny(new[]{'\0','\r','\n'})>=0)throw new ArgumentException("Output must be an absolute local path without streams.");
+  if(OperatingSystem.IsWindows()&&new DriveInfo(Path.GetPathRoot(root)!).DriveType!=DriveType.Fixed)throw new ArgumentException("Output requires a fixed local drive.");
+  for(var dir=new DirectoryInfo(root);dir!=null;dir=dir.Parent)if(dir.Exists&&(dir.Attributes&FileAttributes.ReparsePoint)!=0)throw new ArgumentException("Reparse output directories not supported.");
+ }
+ static void Validate(RecordingRequest r)
+ {
+  if(!r.Consent)throw new ArgumentException("Explicit capture consent required.");
+  if(r.MaxDuration<TimeSpan.FromSeconds(1)||r.MaxDuration>TimeSpan.FromHours(2)||r.MaxBytes<65536||r.MaxBytes>2_000_000_000)throw new ArgumentException("Duration 1s..2h and size 64KiB..2GB required.");
+  if(r.Synthetic&&(r.Screen!=null||r.MicrophoneDevice!=null||r.SystemAudioDevice!=null))throw new ArgumentException("Synthetic mode cannot select hardware.");
+  if(!r.Synthetic&&r.Screen==null)throw new ArgumentException("Explicit screen rectangle required; no fallback.");
+  if(r.Screen is {} s&&(s.Width<2||s.Height<2||s.Width>7680||s.Height>4320||s.Width%2!=0||s.Height%2!=0||(long)s.X+s.Width>int.MaxValue||(long)s.Y+s.Height>int.MaxValue))throw new ArgumentException("Invalid explicit rectangle; even dimensions required.");
+  foreach(var device in new[]{r.MicrophoneDevice,r.SystemAudioDevice})if(device!=null&&(string.IsNullOrWhiteSpace(device)||device.Length>512||device.Any(char.IsControl)||device.Contains((char)58)||device.Contains((char)34)||device.Contains((char)92)))throw new ArgumentException("Invalid selected audio endpoint.");
+ }
+ public static IReadOnlyList<string> BuildArguments(RecordingRequest request,string outputPath)
+ {
+  Validate(request);
+  var a=new List<string>{"-hide_banner","-loglevel","error","-n"};
+  if(request.Synthetic)a.AddRange(new[]{"-re","-f","lavfi","-i","testsrc=size=320x240:rate=15","-re","-f","lavfi","-i","sine=frequency=440:sample_rate=48000"});
+  else
+  {
+   var s=request.Screen!;a.AddRange(new[]{"-f","gdigrab","-framerate","15","-offset_x",s.X.ToString(CultureInfo.InvariantCulture),"-offset_y",s.Y.ToString(CultureInfo.InvariantCulture),"-video_size",$"{s.Width}x{s.Height}","-i","desktop"});
+   foreach(var device in new[]{request.MicrophoneDevice,request.SystemAudioDevice})if(device!=null)a.AddRange(new[]{"-thread_queue_size","512","-f","dshow","-i","audio="+device});
+  }
+  a.AddRange(new[]{"-map","0:v:0"});
+  var audioCount=request.Synthetic?1:(request.MicrophoneDevice!=null?1:0)+(request.SystemAudioDevice!=null?1:0);
+  if(audioCount==1)a.AddRange(new[]{"-map","1:a:0"});
+  if(audioCount==2)a.AddRange(new[]{"-filter_complex","[1:a][2:a]amix=inputs=2:duration=longest[a]","-map","[a]"});
+  a.AddRange(new[]{"-c:v","libx264","-preset","ultrafast","-pix_fmt","yuv420p","-c:a","aac","-t",request.MaxDuration.TotalSeconds.ToString(CultureInfo.InvariantCulture),"-fs",Math.Max(32768,request.MaxBytes-32768).ToString(CultureInfo.InvariantCulture),"-movflags","frag_keyframe+empty_moov","-f","mp4",outputPath});return a.AsReadOnly();
+ }
+ public Task<RecordingSession> StartAsync(RecordingRequest request,CancellationToken cancellationToken=default)
+ {
+  cancellationToken.ThrowIfCancellationRequested();Validate(request);ValidateRoot(_root);
+  if(!File.Exists(_ffmpeg))throw new FileNotFoundException("Caller supplied ffmpeg not found.",_ffmpeg);
+  if(!request.Synthetic&&!OperatingSystem.IsWindows())throw new PlatformNotSupportedException("Hardware capture requires Windows.");
+  Directory.CreateDirectory(_root);ValidateRoot(_root);
+  var file=Path.Combine(_root,Guid.NewGuid().ToString("N")+".partial.mp4");
+  var info=new ProcessStartInfo(_ffmpeg){UseShellExecute=false,CreateNoWindow=true,RedirectStandardInput=true,RedirectStandardError=true};
+  foreach(var arg in BuildArguments(request,file))info.ArgumentList.Add(arg);
+  var process=new Process{StartInfo=info};try{process.Start();return Task.FromResult(new RecordingSession(process,file,request,cancellationToken));}catch{process.Dispose();throw;}
+ }
+}
+
+
