+using System.Diagnostics;
+using System.Text.Json;
+using OpenClicky.Recording;
+using Xunit;
+public class RecorderTests
+{
+ static readonly string Ff = @"C:\Users\ahmad\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\ffmpeg-8.1-full_build\bin\ffmpeg.exe";
+ static string Root()=>Path.Combine(Path.GetTempPath(),"open-clicky-recording-tests",Guid.NewGuid().ToString("N"));
+ static RecordingRequest Fixture(int seconds=1)=>new(true,null,null,null,true,TimeSpan.FromSeconds(seconds),4_000_000);
+ [Fact] public async Task ConsentAndExplicitSourcesRequired(){var r=new FfmpegRecorder(Ff,Root()); await Assert.ThrowsAsync<ArgumentException>(()=>r.StartAsync(Fixture() with{Consent=false}));await Assert.ThrowsAsync<ArgumentException>(()=>r.StartAsync(Fixture() with{Synthetic=false}));}
+ [Fact] public async Task RejectInvalidRectangleAndLimits(){var r=new FfmpegRecorder(Ff,Root());await Assert.ThrowsAsync<ArgumentException>(()=>r.StartAsync(Fixture() with{Synthetic=false,Screen=new(0,0,0,100)}));await Assert.ThrowsAsync<ArgumentException>(()=>r.StartAsync(Fixture() with{MaxDuration=TimeSpan.Zero}));await Assert.ThrowsAsync<ArgumentException>(()=>r.StartAsync(Fixture() with{MaxBytes=1}));}
+ [Theory][InlineData("relative")][InlineData(@"\\server\share")][InlineData(@"C:\bad:stream")]
+ public void UnsafeOutputRootsRejected(string root)=>Assert.ThrowsAny<ArgumentException>(()=>new FfmpegRecorder(Ff,root));
+ [Fact] public void DeviceIsOneArgumentNoShell(){var request=Fixture() with{Synthetic=false,Screen=new(10,20,320,240),MicrophoneDevice="mic -i hacked & calc"}; var args=FfmpegRecorder.BuildArguments(request,@"C:\safe\recording.partial.mp4");Assert.Contains("audio=mic -i hacked & calc",args); Assert.Equal(2,args.Count(a=>a=="-i"));Assert.DoesNotContain("cmd.exe",args);}
+ [Fact] public async Task PrecancelDoesNotCreateOutput(){var root=Root();var r=new FfmpegRecorder(Ff,root);await Assert.ThrowsAnyAsync<OperationCanceledException>(()=>r.StartAsync(Fixture(),new CancellationToken(true)));Assert.False(Directory.Exists(root));}
+ [Fact] public async Task SyntheticEncodeContainsVideoAndAudio(){await using var s=await new FfmpegRecorder(Ff,Root()).StartAsync(Fixture());var result=await s.Completion;Assert.Equal(RecordingStatus.Completed,result.Status);Assert.NotNull(result.MediaPath);var p=new Process{StartInfo=new(Path.Combine(Path.GetDirectoryName(Ff)!,"ffprobe.exe")){UseShellExecute=false,RedirectStandardOutput=true,RedirectStandardError=true,CreateNoWindow=true}};foreach(var a in new[]{"-v","error","-show_streams","-show_format","-of","json",result.MediaPath!})p.StartInfo.ArgumentList.Add(a);p.Start();var json=await p.StandardOutput.ReadToEndAsync();await p.WaitForExitAsync();Assert.Equal(0,p.ExitCode);using var doc=JsonDocument.Parse(json);var streams=doc.RootElement.GetProperty("streams").EnumerateArray().Select(x=>x.GetProperty("codec_type").GetString()).ToArray();Assert.Contains("video",streams);Assert.Contains("audio",streams);Assert.InRange(new FileInfo(result.MediaPath!).Length,1,Fixture().MaxBytes);File.Delete(result.MediaPath!);}
+ [Fact] public async Task CancelDeletesPartialAndIsIdempotent(){await using var s=await new FfmpegRecorder(Ff,Root()).StartAsync(Fixture(30));await s.CancelAsync();await s.CancelAsync();var result=await s.Completion;Assert.Equal(RecordingStatus.Cancelled,result.Status);Assert.Null(result.MediaPath);}
+ [Fact] public async Task StopProducesPlayableLocalOutput(){await using var s=await new FfmpegRecorder(Ff,Root()).StartAsync(Fixture(30));await Task.Delay(800);await s.StopAsync();var result=await s.Completion;Assert.Equal(RecordingStatus.Completed,result.Status);Assert.True(File.Exists(result.MediaPath));File.Delete(result.MediaPath!);}
+ [Fact] public void DeviceSubparserInjectionRejected(){Assert.Throws<ArgumentException>(()=>FfmpegRecorder.BuildArguments(Fixture() with{Synthetic=false,Screen=new(0,0,320,240),MicrophoneDevice="mic:video=other"},@"C:\safe\recording.partial.mp4"));}
+ [Fact] public async Task SyntheticCannotFallBackToHardware(){await Assert.ThrowsAsync<ArgumentException>(()=>new FfmpegRecorder(Ff,Root()).StartAsync(Fixture() with{MicrophoneDevice="selected"}));}
+ [Fact] public async Task ByteBoundNeverPublishesOversize(){await using var s=await new FfmpegRecorder(Ff,Root()).StartAsync(Fixture(3) with{MaxBytes=65536});var r=await s.Completion;Assert.True(r.MediaPath==null||new FileInfo(r.MediaPath).Length<=65536);if(r.MediaPath!=null)File.Delete(r.MediaPath);}
+ [Fact] public async Task MissingExecutableDoesNotFallback(){await Assert.ThrowsAnyAsync<Exception>(()=>new FfmpegRecorder(@"C:\missing-ffmpeg.exe",Root()).StartAsync(Fixture()));}
+ [Fact] public async Task InvalidExecutableFailsWithoutPublishing(){await using var s=await new FfmpegRecorder(Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.System),"where.exe"),Root()).StartAsync(Fixture());var result=await s.Completion;Assert.Equal(RecordingStatus.Failed,result.Status);Assert.Null(result.MediaPath);Assert.InRange(result.Diagnostic.Length,0,8192);}
+ [Fact] public async Task RuntimeCancellationStopsProcess(){using var cts=new CancellationTokenSource();await using var s=await new FfmpegRecorder(Ff,Root()).StartAsync(Fixture(30),cts.Token);cts.Cancel();Assert.Equal(RecordingStatus.Cancelled,(await s.Completion).Status);}
+}
