+using System.Diagnostics;
+using System.Text;
+namespace OpenClicky.Recording;
+public sealed class RecordingSession:IAsyncDisposable
+{
+ readonly Process _process;readonly string _partial;readonly RecordingRequest _request; readonly object _gate=new();readonly StringBuilder _diagnostic=new();readonly CancellationTokenRegistration _registration;
+ int _cancel;int _limit;readonly Task _drain;
+ public Task<RecordingResult> Completion{get;}
+ internal RecordingSession(Process process,string partial,RecordingRequest request,CancellationToken token)
+ {
+  _process=process;_partial=partial;_request=request;_drain=DrainAsync();
+  Completion=ObserveAsync();_registration=token.Register(()=>{Interlocked.Exchange(ref _cancel,1);Kill();});
+ }
+ async Task DrainAsync()
+ {
+  var buffer=new char[1024];int count;while((count=await _process.StandardError.ReadAsync(buffer))>0)lock(_gate){var remaining=8192-_diagnostic.Length;if(remaining>0)_diagnostic.Append(buffer,0,Math.Min(count,remaining));}
+ }
+ void Kill(){try{if(!_process.HasExited)_process.Kill(true);}catch(InvalidOperationException){} }
+ async Task<RecordingResult> ObserveAsync()
+ {
+  var deadline=Stopwatch.StartNew();
+  while(!_process.HasExited)
+  {
+   if(deadline.Elapsed>_request.MaxDuration+TimeSpan.FromSeconds(10)){Interlocked.Exchange(ref _limit,1);Kill();}
+   try{if(File.Exists(_partial)&&new FileInfo(_partial).Length>_request.MaxBytes){Interlocked.Exchange(ref _limit,1);Kill();}}catch(IOException){}
+   await Task.WhenAny(_process.WaitForExitAsync(),Task.Delay(100));
+  }
+  await _process.WaitForExitAsync();await _drain;
+  var status=Volatile.Read(ref _cancel)!=0?RecordingStatus.Cancelled:Volatile.Read(ref _limit)!=0?RecordingStatus.LimitExceeded:_process.ExitCode==0?RecordingStatus.Completed:RecordingStatus.Failed;
+  string? media=null;
+  if(status==RecordingStatus.Completed&&File.Exists(_partial)&&new FileInfo(_partial).Length>0&&new FileInfo(_partial).Length<=_request.MaxBytes){media=_partial.Replace(".partial.mp4",".mp4",StringComparison.Ordinal);File.Move(_partial,media);}
+  else{if(status==RecordingStatus.Completed)status=RecordingStatus.Failed;File.Delete(_partial);}
+  string diagnostic;lock(_gate)diagnostic=_diagnostic.ToString();return new(status,_process.ExitCode,media,_request,diagnostic);
+ }
+ public async Task StopAsync()
+ {
+  if(Completion.IsCompleted){await Completion;return;}
+  try{await _process.StandardInput.WriteLineAsync("q");await _process.StandardInput.FlushAsync();}catch(IOException){}catch(InvalidOperationException){}
+  if(await Task.WhenAny(Completion,Task.Delay(TimeSpan.FromSeconds(5)))!=Completion){Interlocked.Exchange(ref _limit,1);Kill();}await Completion;
+ }
+ public async Task CancelAsync(){Interlocked.Exchange(ref _cancel,1);Kill();await Completion;}
+ public async ValueTask DisposeAsync(){if(!Completion.IsCompleted)await CancelAsync();_registration.Dispose();_process.Dispose();}
+}
