+namespace OpenClicky.Recording;
+public sealed record ScreenRectangle(int X,int Y,int Width,int Height);
+/// <summary>Device names are exact DirectShow audio endpoint names, not WASAPI IDs. No default-device lookup.</summary>
+public sealed record RecordingRequest(bool Consent,ScreenRectangle? Screen,string? MicrophoneDevice,string? SystemAudioDevice,bool Synthetic,TimeSpan MaxDuration,long MaxBytes);
+public enum RecordingStatus { Completed, Cancelled, Failed, LimitExceeded }
+public sealed record RecordingResult(RecordingStatus Status,int ExitCode,string? MediaPath,RecordingRequest Sources,string Diagnostic);
