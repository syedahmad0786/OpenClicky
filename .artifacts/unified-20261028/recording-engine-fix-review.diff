+using System.Diagnostics;
+using System.Globalization;
+using System.Text.Json;
+using OpenClicky.Recording;
+using Xunit;
+
+public class SyntheticTests
+{
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public async Task IndependentlyAllowlistedEncodeAndStopDecode(bool stop)
+    {
+        var executable = Environment.GetEnvironmentVariable("OPENCLICKY_TEST_FFMPEG");
+        Assert.True(!string.IsNullOrWhiteSpace(executable), "Set OPENCLICKY_TEST_FFMPEG explicitly to run real synthetic checks.");
+        var probe = Environment.GetEnvironmentVariable("OPENCLICKY_TEST_FFPROBE");
+        Assert.True(!string.IsNullOrWhiteSpace(probe), "Set OPENCLICKY_TEST_FFPROBE explicitly.");
+        var root = RecorderTests.Root();
+        var request = RecorderTests.Fixture() with { MaxDuration = TimeSpan.FromSeconds(stop ? 30 : 1) };
+        var launcher = new SyntheticOnlyLauncher(root, request);
+        await using var session = await new FfmpegRecorder(executable!, root, launcher,
+            new RecordingFiles(), TimeSpan.FromSeconds(2)).StartAsync(request);
+        if (stop) { await Task.Delay(1200); await session.StopAsync(); }
+        var result = await session.Completion;
+        Assert.Equal(RecordingStatus.Completed, result.Status);
+        var json = await Tool(probe!, new[] { "-v", "error", "-show_streams", "-show_format", "-of", "json", result.MediaPath! });
+        using var doc = JsonDocument.Parse(json);
+        var streams = doc.RootElement.GetProperty("streams").EnumerateArray().Select(s => s.GetProperty("codec_type").GetString()).ToArray();
+        Assert.Contains("video", streams);
+        Assert.Contains("audio", streams);
+        Assert.InRange(double.Parse(doc.RootElement.GetProperty("format").GetProperty("duration").GetString()!, CultureInfo.InvariantCulture), 0.1, stop ? 10 : 2);
+        Assert.InRange(new FileInfo(result.MediaPath!).Length, 1, request.MaxBytes);
+        // Decode only this generated output, never a live input.
+        await Tool(executable!, new[] { "-v", "error", "-i", result.MediaPath!, "-f", "null", "-" });
+        Console.WriteLine($"SYNTHETIC RECEIPT stop={stop} file={result.MediaPath} bytes={new FileInfo(result.MediaPath!).Length} sources=lavfi:testsrc+lavfi:sine probe={json}");
+        File.Delete(result.MediaPath!);
+        Assert.Empty(Directory.GetFiles(root));
+    }
+
+    [Fact]
+    public void IndependentGuardRejectsHardwareEvenIfProductionValidationRegresses()
+    {
+        var root = RecorderTests.Root();
+        var guard = new SyntheticOnlyLauncher(root, RecorderTests.Fixture());
+        Assert.Throws<InvalidOperationException>(() => guard.Launch("not executed", new[] { "-f", "gdigrab", "-i", "desktop", Path.Combine(root, "x.partial.mp4") }));
+    }
+
+    internal static async Task<string> Tool(string executable, IReadOnlyList<string> args)
+    {
+        var info = new ProcessStartInfo(executable) { UseShellExecute = false, RedirectStandardOutput = true, RedirectStandardError = true, CreateNoWindow = true };
+        foreach (var arg in args) info.ArgumentList.Add(arg);
+        using var process = Process.Start(info)!;
+        var output = process.StandardOutput.ReadToEndAsync();
+        var error = process.StandardError.ReadToEndAsync();
+        try { await process.WaitForExitAsync().WaitAsync(TimeSpan.FromSeconds(15)); }
+        catch { process.Kill(true); await process.WaitForExitAsync().WaitAsync(TimeSpan.FromSeconds(2)); throw; }
+        Assert.True(process.ExitCode == 0, await error);
+        return await output;
+    }
+}
+
+internal sealed class SyntheticOnlyLauncher(string root, RecordingRequest request) : IEncoderLauncher
+{
+    public IEncoderProcess Launch(string executable, IReadOnlyList<string> arguments)
+    {
+        // Independent literal allowlist: do not call BuildArguments or trust Synthetic/validation.
+        var output = arguments.LastOrDefault() ?? "";
+        var allowed = new[] {
+            "-hide_banner", "-loglevel", "error", "-n",
+            "-re", "-f", "lavfi", "-i", "testsrc=size=320x240:rate=15",
+            "-re", "-f", "lavfi", "-i", "sine=frequency=440:sample_rate=48000",
+            "-map", "0:v:0", "-map", "1:a:0", "-c:v", "libx264", "-preset", "ultrafast",
+            "-pix_fmt", "yuv420p", "-c:a", "aac", "-t", request.MaxDuration.TotalSeconds.ToString(CultureInfo.InvariantCulture),
+            "-fs", Math.Max(32768, request.MaxBytes - 32768).ToString(CultureInfo.InvariantCulture),
+            "-movflags", "frag_keyframe+empty_moov", "-f", "mp4", output };
+        if (Path.GetDirectoryName(output) != root || !output.EndsWith(".partial.mp4", StringComparison.Ordinal)
+            || !arguments.SequenceEqual(allowed)) throw new InvalidOperationException("Non-allowlisted synthetic launch refused.");
+        return new EncoderLauncher().Launch(executable, arguments);
+    }
+}
