@@ -0,0 +1,73 @@
+using System.Diagnostics;
+using System.Runtime.CompilerServices;
+[assembly: InternalsVisibleTo("OpenClicky.Recording.Tests")]
+namespace OpenClicky.Recording;
+
+internal interface IEncoderProcess : IDisposable
+{
+    Task Exit { get; }
+    int ExitCode { get; }
+    Task<string> ReadErrorAsync();
+    Task StopAsync();
+    void Kill();
+}
+
+internal interface IEncoderLauncher
+{
+    IEncoderProcess Launch(string executable, IReadOnlyList<string> arguments);
+}
+
+internal interface IRecordingFiles
+{
+    long Length(string path);
+    void Publish(string partial, string final);
+    void Delete(string path);
+}
+
+internal sealed class RecordingFiles : IRecordingFiles
+{
+    public long Length(string path) => File.Exists(path) ? new FileInfo(path).Length : 0;
+    public void Publish(string partial, string final) => File.Move(partial, final);
+    public void Delete(string path) => File.Delete(path);
+}
+
+internal sealed class EncoderLauncher : IEncoderLauncher
+{
+    public IEncoderProcess Launch(string executable, IReadOnlyList<string> arguments)
+    {
+        var info = new ProcessStartInfo(executable)
+        {
+            UseShellExecute = false,
+            CreateNoWindow = true,
+            RedirectStandardInput = true,
+            RedirectStandardError = true
+        };
+        foreach (var argument in arguments) info.ArgumentList.Add(argument);
+        var process = new Process { StartInfo = info };
+        try { process.Start(); return new EncoderProcess(process); }
+        catch { process.Dispose(); throw; }
+    }
+}
+
+internal sealed class EncoderProcess(Process process) : IEncoderProcess
+{
+    public Task Exit { get; } = process.WaitForExitAsync();
+    public int ExitCode => process.ExitCode;
+    public Task<string> ReadErrorAsync() => ReadBoundedAsync();
+    private async Task<string> ReadBoundedAsync()
+    {
+        var text = new System.Text.StringBuilder();
+        var buffer = new char[1024];
+        int count;
+        while ((count = await process.StandardError.ReadAsync(buffer)) > 0)
+            if (text.Length < 8192) text.Append(buffer, 0, Math.Min(count, 8192 - text.Length));
+        return text.ToString();
+    }
+    public async Task StopAsync()
+    {
+        await process.StandardInput.WriteLineAsync("q");
+        await process.StandardInput.FlushAsync();
+    }
+    public void Kill() { if (!process.HasExited) process.Kill(true); }
+    public void Dispose() => process.Dispose();
+}
