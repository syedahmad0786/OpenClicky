+using OpenClicky.Recording;
+using Xunit;
+
+public class FaultTests
+{
+    private static FfmpegRecorder Recorder(string root, FakeLauncher fake, IRecordingFiles? files = null) =>
+        new(Environment.ProcessPath!, root, fake, files ?? new RecordingFiles(), TimeSpan.FromMilliseconds(60));
+
+    [Fact]
+    public async Task CancelAndConcurrentDisposeRemoveAllFiles()
+    {
+        var root = RecorderTests.Root();
+        var fake = new FakeLauncher { Started = p => File.WriteAllText(p, "fake") };
+        var session = await Recorder(root, fake).StartAsync(RecorderTests.Fixture());
+        await Task.WhenAll(session.CancelAsync(), session.DisposeAsync().AsTask(), session.DisposeAsync().AsTask());
+        Assert.Equal(RecordingStatus.Cancelled, (await session.Completion).Status);
+        Assert.Empty(Directory.GetFiles(root));
+        Assert.True(fake.Process.Disposed);
+        Assert.True(fake.Process.Exit.IsCompleted);
+    }
+
+    [Theory]
+    [InlineData(true, false, false)]
+    [InlineData(false, true, false)]
+    [InlineData(false, false, true)]
+    public async Task FaultsAreBoundedAndReported(bool stdin, bool kill, bool stderr)
+    {
+        var root = RecorderTests.Root();
+        var fake = new FakeLauncher { Started = p => File.WriteAllText(p, "fake") };
+        fake.Process.BlockStop = stdin;
+        fake.Process.KillFails = kill;
+        fake.Process.BlockError = stderr;
+        await using var session = await Recorder(root, fake).StartAsync(RecorderTests.Fixture());
+        if (kill) await session.CancelAsync(); else await session.StopAsync();
+        var result = await session.Completion.WaitAsync(TimeSpan.FromSeconds(2));
+        Assert.Contains(kill ? "Kill failed" : stdin ? "stdin failed" : "stderr drain failed", result.Diagnostic);
+        Assert.True(fake.Process.Disposed);
+        if (kill || stdin) Assert.Empty(Directory.GetFiles(root));
+        // A failed kill explicitly cannot prove the child exited.
+        if (kill) Assert.False(fake.Process.Exit.IsCompleted);
+    }
+
+    [Theory]
+    [InlineData(true, false)]
+    [InlineData(false, true)]
+    public async Task FilesystemFaultsNeverPublish(bool rename, bool delete)
+    {
+        var root = RecorderTests.Root();
+        var fake = new FakeLauncher { Started = p => File.WriteAllText(p, "fake") };
+        var files = new FaultFiles { RenameFails = rename, DeleteFails = delete };
+        await using var session = await Recorder(root, fake, files).StartAsync(RecorderTests.Fixture());
+        if (delete) await session.CancelAsync(); else fake.Process.Done.TrySetResult();
+        var result = await session.Completion;
+        Assert.Null(result.MediaPath);
+        Assert.Contains(delete ? "manual recovery" : "rename fault", result.Diagnostic);
+        Assert.DoesNotContain(Directory.GetFiles(root), p => !p.EndsWith(".partial.mp4"));
+        Assert.Equal(delete ? 1 : 0, Directory.GetFiles(root).Length);
+        foreach (var path in Directory.GetFiles(root)) File.Delete(path);
+    }
+
+    [Fact]
+    public async Task CancellationBeforeCommitWinsAgainstStop()
+    {
+        var root = RecorderTests.Root();
+        var fake = new FakeLauncher { Started = p => File.WriteAllText(p, "fake") };
+        fake.Process.BlockStop = true;
+        await using var session = await Recorder(root, fake).StartAsync(RecorderTests.Fixture());
+        var stop = session.StopAsync();
+        await session.CancelAsync();
+        await stop;
+        Assert.Equal(RecordingStatus.Cancelled, (await session.Completion).Status);
+        Assert.Empty(Directory.GetFiles(root));
+    }
+
+    [Fact]
+    public async Task CancellationAfterPublicationDoesNotUndoTerminalCommit()
+    {
+        var root = RecorderTests.Root();
+        var fake = new FakeLauncher { Started = p => File.WriteAllText(p, "fake") };
+        await using var session = await Recorder(root, fake).StartAsync(RecorderTests.Fixture());
+        fake.Process.Done.TrySetResult();
+        var result = await session.Completion;
+        await session.CancelAsync();
+        Assert.Equal(RecordingStatus.Completed, result.Status);
+        Assert.Equal(root, Path.GetDirectoryName(result.MediaPath));
+        Assert.Single(Directory.GetFiles(root));
+        File.Delete(result.MediaPath!);
+    }
+
+    [Fact]
+    public async Task FailureExitAndOversizeRemovePartial()
+    {
+        foreach (var oversize in new[] { false, true })
+        {
+            var root = RecorderTests.Root();
+            var fake = new FakeLauncher { Started = p => File.WriteAllBytes(p, new byte[oversize ? 65537 : 10]) };
+            fake.Process.ExitCode = oversize ? 0 : 1;
+            await using var session = await Recorder(root, fake).StartAsync(RecorderTests.Fixture() with { MaxBytes = 65536 });
+            fake.Process.Done.TrySetResult();
+            var result = await session.Completion;
+            Assert.Null(result.MediaPath);
+            Assert.Empty(Directory.GetFiles(root));
+            Assert.True(fake.Process.Disposed);
+        }
+    }
+
+    [Fact]
+    public async Task PrecancelAndValidationNeverReachLauncher()
+    {
+        var fake = new FakeLauncher { Started = _ => throw new Exception("launcher reached") };
+        var root = RecorderTests.Root();
+        var recorder = Recorder(root, fake);
+        await Assert.ThrowsAnyAsync<OperationCanceledException>(() => recorder.StartAsync(RecorderTests.Fixture(), new CancellationToken(true)));
+        foreach (var request in new[] {
+            RecorderTests.Fixture() with { Consent = false },
+            RecorderTests.Fixture() with { Synthetic = false },
+            RecorderTests.Fixture() with { MicrophoneDevice = "mic" },
+            RecorderTests.Fixture() with { MaxBytes = 1 },
+            RecorderTests.Fixture() with { MaxDuration = TimeSpan.Zero },
+            RecorderTests.Fixture() with { Synthetic = false, Screen = new(0,0,3,4) } })
+            await Assert.ThrowsAsync<ArgumentException>(() => recorder.StartAsync(request));
+        Assert.False(Directory.Exists(root));
+    }
+
+    [Theory]
+    [InlineData("relative")]
+    [InlineData(@"\\server\share\ffmpeg.exe")]
+    [InlineData(@"C:\bad:stream")]
+    public void UnsafeExecutableRejected(string path) => Assert.ThrowsAny<ArgumentException>(() => new FfmpegRecorder(path, RecorderTests.Root()));
+
+    [Fact]
+    public void ArgumentGrammarAndNoDefaultSources()
+    {
+        var request = RecorderTests.Fixture() with { Synthetic = false, Screen = new(10, 20, 320, 240), MicrophoneDevice = "mic & literal" };
+        var args = FfmpegRecorder.BuildArguments(request, "output.partial.mp4");
+        Assert.Contains("audio=mic & literal", args);
+        Assert.Equal(2, args.Count(a => a == "-i"));
+        Assert.DoesNotContain("wasapi", args);
+        foreach (var device in new[] { "mic:video=other", "mic\"", "mic\\" })
+            Assert.Throws<ArgumentException>(() => FfmpegRecorder.BuildArguments(request with { MicrophoneDevice = device }, "out"));
+    }
+}
+
+internal sealed class FaultFiles : IRecordingFiles
+{
+    internal bool RenameFails, DeleteFails;
+    public long Length(string path) => File.Exists(path) ? new FileInfo(path).Length : 0;
+    public void Publish(string partial, string final) { if (RenameFails) throw new IOException("rename fault"); File.Move(partial, final); }
+    public void Delete(string path) { if (DeleteFails) throw new IOException("delete fault"); File.Delete(path); }
+}
