+internal sealed class FakeLauncher : IEncoderLauncher
+{
+    internal FakeProcess Process = new();
+    internal Action<string>? Started;
+    public IEncoderProcess Launch(string executable, IReadOnlyList<string> arguments)
+    {
+        Started?.Invoke(arguments[^1]);
+        return Process;
+    }
+}
 
+internal sealed class FakeProcess : IEncoderProcess
+{
+    internal readonly TaskCompletionSource Done = new(TaskCreationOptions.RunContinuationsAsynchronously);
+    internal bool Killed, Disposed, KillFails, BlockStop, BlockError;
+    public Task Exit => Done.Task;
+    public int ExitCode { get; set; }
+    public Task<string> ReadErrorAsync() => BlockError ? new TaskCompletionSource<string>().Task : Task.FromResult("fake diagnostic");
+    public Task StopAsync() { if (BlockStop) return new TaskCompletionSource().Task; Done.TrySetResult(); return Task.CompletedTask; }
+    public void Kill() { Killed = true; if (KillFails) throw new IOException("kill fault"); Done.TrySetResult(); }
+    public void Dispose() => Disposed = true;
