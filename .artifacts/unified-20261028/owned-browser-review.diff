+++ b/apps/windows/OpenClicky.Core/OwnedBrowser/OwnedBrowserStore.cs
@@ -0,0 +1,227 @@
+using System.Text.Json;
+using System.Text.Json.Serialization;
+
+namespace OpenClicky.Core.OwnedBrowser;
+
+/// <summary>Single-writer local workspace metadata, not a browser driver or security sandbox.
+/// Supply an application-owned storage parent, never a user browser directory. No profile import is supported.</summary>
+public sealed class OwnedBrowserStore : IDisposable
+{
+    private const string Marker = "OpenClicky.OwnedBrowser/1";
+    private static readonly JsonSerializerOptions JsonOptions = new() { UnmappedMemberHandling = JsonUnmappedMemberHandling.Disallow };
+    private readonly string root;
+    private readonly object gate = new();
+    private readonly FileStream lease;
+    private State state;
+    private bool disposed;
+    private sealed record State(int Version, OwnedWorkspace[] Workspaces);
+
+    public OwnedBrowserStore(string storageParent)
+    {
+        if (string.IsNullOrWhiteSpace(storageParent) || !Path.IsPathFullyQualified(storageParent) ||
+            storageParent.Split(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar).Any(p => p is ".." or "."))
+            throw new ArgumentException("An absolute storage parent without traversal is required.", nameof(storageParent));
+        root = Path.Combine(Path.GetFullPath(storageParent), "OwnedBrowser-v1");
+        CheckPath(root);
+        var marker = Path.Combine(root, ".owned-browser");
+        var initialized = File.Exists(marker);
+        if (Directory.Exists(root) && !initialized && Directory.EnumerateFileSystemEntries(root).Any())
+            throw new InvalidOperationException("Refusing a foreign browser root.");
+        Directory.CreateDirectory(root);
+        CheckPath(root);
+        CheckPath(Path.Combine(root,"store.lock"));
+        lease = new FileStream(Path.Combine(root,"store.lock"), FileMode.OpenOrCreate, FileAccess.ReadWrite, FileShare.None);
+        try
+        {
+            if (initialized)
+            {
+                CheckMarker(marker, Marker);
+                state = Load();
+            }
+            else
+            {
+                File.WriteAllText(marker, Marker);
+                state = new State(1, []);
+                Persist(state);
+            }
+            CheckPath(Path.Combine(root,"profiles"));
+            Directory.CreateDirectory(Path.Combine(root,"profiles"));
+            foreach (var w in state.Workspaces) VerifyProfile(w.Id);
+        }
+        catch { lease.Dispose(); throw; }
+    }
+
+    public IReadOnlyList<OwnedWorkspace> List()
+    {
+        lock (gate) { Guard(); return Array.AsReadOnly(state.Workspaces.Select(Freeze).ToArray()); }
+    }
+    public OwnedWorkspace CreateWorkspace(string id, string name)
+    {
+        lock(gate)
+        {
+            Guard(); id = OwnedBrowserPolicy.CanonicalWorkspaceId(id);
+            if (string.IsNullOrWhiteSpace(name) || name.Length > 100 || name.Any(char.IsControl)) throw new ArgumentException("Invalid workspace name.",nameof(name));
+            if (state.Workspaces.Any(w=>w.Id==id)) throw new InvalidOperationException("Workspace already exists.");
+            if(state.Workspaces.Length >= OwnedBrowserPolicy.MaxWorkspaces) throw new InvalidOperationException("Workspace limit reached.");
+            var profile=Profile(id); CheckPath(profile);
+            if(Directory.Exists(profile)) VerifyProfile(id);
+            else
+            {
+                Directory.CreateDirectory(profile); CheckPath(profile);
+                File.WriteAllText(Path.Combine(profile,".owned-profile"), Marker + "/" + id);
+            }
+            var workspace=new OwnedWorkspace(id,name,Array.Empty<OwnedTab>());
+            Commit(state with { Workspaces = [..state.Workspaces,workspace] });
+            return Freeze(workspace);
+        }
+    }
+    public string GetProfileDirectory(string workspaceId)
+    {
+        lock(gate) { Guard(); var w=Find(workspaceId); VerifyProfile(w.Id); return Profile(w.Id); }
+    }
+    public OwnedTab OpenTab(string workspaceId, string url)
+    {
+        lock(gate)
+        {
+            Guard(); var w=Find(workspaceId); url=OwnedBrowserPolicy.AdmitNavigation(url);
+            if(w.Tabs.Count >= OwnedBrowserPolicy.MaxTabsPerWorkspace || state.Workspaces.Sum(x=>x.Tabs.Count) >= OwnedBrowserPolicy.MaxTotalTabs)
+                throw new InvalidOperationException("Tab limit reached.");
+            var tab=new OwnedTab(Guid.NewGuid(),url); Replace(w with { Tabs = w.Tabs.Append(tab).ToArray() }); return tab;
+        }
+    }
+    public OwnedTab Navigate(string workspaceId, Guid tabId, string url)
+    {
+        lock(gate)
+        {
+            Guard(); var w=Find(workspaceId); RequireTab(w,tabId); url=OwnedBrowserPolicy.AdmitNavigation(url);
+            var tab=new OwnedTab(tabId,url); Replace(w with { Tabs=w.Tabs.Select(t=>t.Id==tabId?tab:t).ToArray() }); return tab;
+        }
+    }
+    public void CloseTab(string workspaceId, Guid tabId)
+    {
+        lock(gate) { Guard(); var w=Find(workspaceId); RequireTab(w,tabId); Replace(w with { Tabs=w.Tabs.Where(t=>t.Id!=tabId).ToArray() }); }
+    }
+    /// <summary>Call only after the host has disposed all workspace WebView2 environments.
+    /// Metadata removal is atomic; physical deletion is a subsequent operation and can fail leaving an orphan.</summary>
+    public void RemoveWorkspace(string workspaceId, ProfileRemoval profileRemoval)
+    {
+        lock(gate)
+        {
+            Guard(); if(!Enum.IsDefined(profileRemoval)) throw new ArgumentException("Explicit removal choice required.",nameof(profileRemoval));
+            var w=Find(workspaceId); VerifyProfile(w.Id); var profile=Profile(w.Id);
+            if(profileRemoval==ProfileRemoval.Delete) CheckTree(profile);
+            Commit(state with { Workspaces=state.Workspaces.Where(x=>x.Id!=w.Id).ToArray() });
+            if(profileRemoval==ProfileRemoval.Delete) { CheckTree(profile); Directory.Delete(profile,true); }
+        }
+    }
+    public void Dispose() { lock(gate) { if(disposed) return; disposed=true; lease.Dispose(); } }
+    private void Guard()
+    {
+        ObjectDisposedException.ThrowIf(disposed,this); CheckPath(root); CheckMarker(Path.Combine(root,".owned-browser"),Marker);
+    }
+    private string Profile(string id) => Path.Combine(root,"profiles",id);
+    private OwnedWorkspace Find(string id)
+    {
+        id=OwnedBrowserPolicy.CanonicalWorkspaceId(id);
+        return state.Workspaces.SingleOrDefault(w=>w.Id==id) ?? throw new InvalidOperationException("Workspace is not owned by this store.");
+    }
+    private static void RequireTab(OwnedWorkspace w, Guid id)
+    { if(!w.Tabs.Any(t=>t.Id==id)) throw new InvalidOperationException("Tab is not owned by this workspace."); }
+    private static OwnedWorkspace Freeze(OwnedWorkspace w) => w with { Tabs=Array.AsReadOnly(w.Tabs.ToArray()) };
+    private void VerifyProfile(string id)
+    {
+        var p=Profile(id); CheckPath(p);
+        if(!Directory.Exists(p)) throw new InvalidOperationException("Owned profile is missing.");
+        CheckMarker(Path.Combine(p,".owned-profile"),Marker+"/"+id);
+    }
+    private static void CheckMarker(string path,string expected)
+    {
+        CheckPath(path);
+        if(!File.Exists(path) || new FileInfo(path).Length > 128 || File.ReadAllText(path)!=expected)
+            throw new InvalidOperationException("Ownership marker missing or invalid.");
+    }
+    private void Replace(OwnedWorkspace w) => Commit(state with { Workspaces=state.Workspaces.Select(x=>x.Id==w.Id?w:x).ToArray() });
+    private void Commit(State candidate) { Persist(candidate); state=candidate; }
+    private State Load()
+    {
+        var path=Path.Combine(root,"state.json"); CheckPath(path);
+        if(!File.Exists(path)) throw new InvalidDataException("Owned browser state is missing.");
+        using var input=new FileStream(path,FileMode.Open,FileAccess.Read,FileShare.Read);
+        if(input.Length > OwnedBrowserPolicy.MaxStateBytes) throw new InvalidDataException("State is oversized.");
+        try
+        {
+            using var document=JsonDocument.Parse(input);
+            RejectDuplicateProperties(document.RootElement);
+            var result=document.RootElement.Deserialize<State>(JsonOptions) ?? throw new InvalidDataException("Null state.");
+            Validate(result); return result;
+        }
+        catch(Exception e) when(e is JsonException or ArgumentException or NullReferenceException)
+        { throw new InvalidDataException("Invalid owned browser state.",e); }
+    }
+    private static void RejectDuplicateProperties(JsonElement element)
+    {
+        if(element.ValueKind==JsonValueKind.Object)
+        {
+            var names=new HashSet<string>(StringComparer.Ordinal);
+            foreach(var property in element.EnumerateObject())
+            {
+                if(!names.Add(property.Name)) throw new InvalidDataException("Duplicate state property.");
+                RejectDuplicateProperties(property.Value);
+            }
+        }
+        else if(element.ValueKind==JsonValueKind.Array)
+            foreach(var child in element.EnumerateArray()) RejectDuplicateProperties(child);
+    }
+    private static void Validate(State value)
+    {
+        if(value.Version!=1 || value.Workspaces is null || value.Workspaces.Length > OwnedBrowserPolicy.MaxWorkspaces) throw new InvalidDataException("Invalid state version or workspaces.");
+        var ids=new HashSet<string>(); var tabs=new HashSet<Guid>();
+        foreach(var w in value.Workspaces)
+        {
+            if(w is null || OwnedBrowserPolicy.CanonicalWorkspaceId(w.Id)!=w.Id || !ids.Add(w.Id) || string.IsNullOrWhiteSpace(w.Name) || w.Name.Length>100 || w.Name.Any(char.IsControl) || w.Tabs is null || w.Tabs.Count>OwnedBrowserPolicy.MaxTabsPerWorkspace)
+                throw new InvalidDataException("Invalid workspace.");
+            foreach(var t in w.Tabs)
+            {
+                if(t is null || t.Id==Guid.Empty || !tabs.Add(t.Id)) throw new InvalidDataException("Invalid tab identity.");
+                OwnedBrowserPolicy.AdmitNavigation(t.Url);
+            }
+        }
+        if(tabs.Count>OwnedBrowserPolicy.MaxTotalTabs) throw new InvalidDataException("Too many tabs.");
+    }
+    private void Persist(State value)
+    {
+        Validate(value); CheckPath(root);
+        var bytes=JsonSerializer.SerializeToUtf8Bytes(value,JsonOptions);
+        if(bytes.Length>OwnedBrowserPolicy.MaxStateBytes) throw new InvalidDataException("State is oversized.");
+        var dest=Path.Combine(root,"state.json"); CheckPath(dest);
+        var tmp=Path.Combine(root,Guid.NewGuid().ToString("N")+".tmp");
+        try
+        {
+            using(var output=new FileStream(tmp,FileMode.CreateNew,FileAccess.Write,FileShare.None)) { output.Write(bytes); output.Flush(true); }
+            CheckPath(dest); File.Move(tmp,dest,true);
+        }
+        finally { if(File.Exists(tmp)) File.Delete(tmp); }
+    }
+    private static void CheckPath(string path)
+    {
+        for(string? p=Path.GetFullPath(path); p is not null; p=Path.GetDirectoryName(p))
+        {
+            try { if((File.GetAttributes(p)&FileAttributes.ReparsePoint)!=0) throw new IOException("Reparse points are not permitted in owned browser paths."); }
+            catch(FileNotFoundException) { } catch(DirectoryNotFoundException) { }
+        }
+    }
+    private static void CheckTree(string path)
+    {
+        var pending=new Stack<string>(); pending.Push(path); var count=0;
+        while(pending.TryPop(out var dir))
+        {
+            CheckPath(dir);
+            foreach(var entry in Directory.EnumerateFileSystemEntries(dir))
+            {
+                if(++count>100000) throw new IOException("Profile deletion entry limit reached.");
+                CheckPath(entry);
+                if(Directory.Exists(entry)) pending.Push(entry);
+            }
+        }
+    }
+}
