+namespace OpenClicky.Core.OwnedBrowser;
+
+public enum ProfileRemoval { Keep, Delete }
+public sealed record OwnedTab(Guid Id, string Url);
+public sealed record OwnedWorkspace(string Id, string Name, IReadOnlyList<OwnedTab> Tabs);
+
+/// <summary>Admission rules only. The WebView2 host must enforce these on redirects,
+/// new windows, permissions, downloads, messages and external protocol requests too.</summary>
+public static class OwnedBrowserPolicy
+{
+    public const int MaxWorkspaces = 16, MaxTabsPerWorkspace = 32, MaxTotalTabs = 128, MaxStateBytes = 1048576;
+    public static bool AllowsHostObjects => false;
+    public static bool AllowsWebMessages => false;
+    public static bool AllowsDownloads => false;
+    public static bool AllowsExternalLaunch => false;
+    public static bool AllowsPermission(string permission) => false;
+    public static string CanonicalWorkspaceId(string id)
+    {
+        if (id is null || !(Guid.TryParseExact(id, "N", out var value) || Guid.TryParseExact(id, "D", out value)) || value == Guid.Empty)
+            throw new ArgumentException("Workspace identity must be a nonempty GUID.", nameof(id));
+        return value.ToString("N");
+    }
+    public static string AdmitNavigation(string url)
+    {
+        if (string.IsNullOrEmpty(url) || url.Length > 4096 || url.Any(c => char.IsControl(c) || char.IsWhiteSpace(c)) || url.Contains('\\'))
+            throw new ArgumentException("Invalid navigation.", nameof(url));
+        if (url == "about:blank") return url;
+        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri) || (uri.Scheme != "https" && uri.Scheme != "http") ||
+            string.IsNullOrEmpty(uri.Host) || uri.UserInfo.Length != 0 || !url.StartsWith(uri.Scheme + "://", StringComparison.OrdinalIgnoreCase))
+            throw new ArgumentException("Only HTTP, HTTPS and about:blank are admitted.", nameof(url));
+        return url;
+    }
+}
diff --git a/apps/windows/OpenClicky.Core/OwnedBrowser/OwnedBrowserStore.cs b/apps/windows/OpenClicky.Core/OwnedBrowser/OwnedBrowserStore.cs
