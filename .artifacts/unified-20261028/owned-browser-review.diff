+using OpenClicky.Core.OwnedBrowser;
+
+namespace OpenClicky.Core.Tests.OwnedBrowser;
+
+public sealed class OwnedBrowserTests : IDisposable
+{
+    private readonly string root = Path.Combine(Path.GetTempPath(), "OpenClicky-OwnedTests-" + Guid.NewGuid().ToString("N"));
+    private static string Id() => Guid.NewGuid().ToString("N");
+    public void Dispose() { if (Directory.Exists(root)) Directory.Delete(root, true); }
+
+    [Fact] public void CanonicalIdentity()
+    {
+        var id = Guid.NewGuid();
+        Assert.Equal(id.ToString("N"), OwnedBrowserPolicy.CanonicalWorkspaceId(id.ToString("D").ToUpperInvariant()));
+        Assert.Throws<ArgumentException>(() => OwnedBrowserPolicy.CanonicalWorkspaceId("../Default"));
+        Assert.Throws<ArgumentException>(() => OwnedBrowserPolicy.CanonicalWorkspaceId(Guid.Empty.ToString()));
+    }
+    [Theory]
+    [InlineData("file:///C:/secret")][InlineData("javascript:alert(1)")][InlineData("data:text/html,x")]
+    [InlineData("ms-settings:privacy")][InlineData("about:config")][InlineData("https://user:pass@example.com")]
+    [InlineData(" https://example.com")][InlineData("https://example.com\n")][InlineData("//example.com")]
+    public void RejectUnsafeNavigation(string url) => Assert.Throws<ArgumentException>(() => OwnedBrowserPolicy.AdmitNavigation(url));
+    [Theory][InlineData("https://example.com/a?q=1")][InlineData("http://localhost:8080/")][InlineData("about:blank")]
+    public void AdmitLimitedNavigation(string url) => Assert.Equal(url, OwnedBrowserPolicy.AdmitNavigation(url));
+    [Fact] public void PageAuthorityDenied()
+    {
+        Assert.False(OwnedBrowserPolicy.AllowsPermission("camera"));
+        Assert.False(OwnedBrowserPolicy.AllowsPermission("unknown"));
+        Assert.False(OwnedBrowserPolicy.AllowsHostObjects); Assert.False(OwnedBrowserPolicy.AllowsWebMessages);
+        Assert.False(OwnedBrowserPolicy.AllowsDownloads); Assert.False(OwnedBrowserPolicy.AllowsExternalLaunch);
+    }
+    [Fact] public void ProfilesAndTabsAreIsolatedAndDurable()
+    {
+        var a = Id(); var b = Id(); Guid tab;
+        using (var store = new OwnedBrowserStore(root))
+        {
+            store.CreateWorkspace(a, "Work"); store.CreateWorkspace(b, "Personal");
+            Assert.NotEqual(store.GetProfileDirectory(a), store.GetProfileDirectory(b));
+            Assert.StartsWith(Path.Combine(root, "OwnedBrowser-v1"), store.GetProfileDirectory(a));
+            tab = store.OpenTab(a, "https://example.com").Id;
+            Assert.Throws<InvalidOperationException>(() => store.Navigate(b, tab, "about:blank"));
+            Assert.Throws<InvalidOperationException>(() => store.CloseTab(b, tab));
+            store.Navigate(a, tab, "https://example.org");
+        }
+        using var reopened = new OwnedBrowserStore(root);
+        Assert.Equal("https://example.org", reopened.List().Single(w => w.Id == a).Tabs.Single().Url);
+        Assert.Empty(reopened.List().Single(w => w.Id == b).Tabs);
+        reopened.CloseTab(a, tab); Assert.Empty(reopened.List().Single(w => w.Id == a).Tabs);
+    }
+    [Fact] public void CapsAndDuplicateIdentity()
+    {
+        using var store = new OwnedBrowserStore(root); var id = Id(); store.CreateWorkspace(id, "W");
+        Assert.Throws<InvalidOperationException>(() => store.CreateWorkspace(id, "Again"));
+        for (var i = 0; i < OwnedBrowserPolicy.MaxTabsPerWorkspace; i++) store.OpenTab(id, "about:blank");
+        Assert.Throws<InvalidOperationException>(() => store.OpenTab(id, "about:blank"));
+        for (var i = 1; i < OwnedBrowserPolicy.MaxWorkspaces; i++) store.CreateWorkspace(Id(), "W");
+        Assert.Throws<InvalidOperationException>(() => store.CreateWorkspace(Id(), "W"));
+    }
+    [Fact] public void TotalTabCap()
+    {
+        using var store = new OwnedBrowserStore(root);
+        for(var i=0;i<4;i++) { var id=Id(); store.CreateWorkspace(id,"W"); for(var j=0;j<32;j++) store.OpenTab(id,"about:blank"); }
+        var extra=Id(); store.CreateWorkspace(extra,"W");
+        Assert.Throws<InvalidOperationException>(()=>store.OpenTab(extra,"about:blank"));
+    }
+    [Fact] public void ExclusiveLeaseAndDisposedGuard()
+    {
+        var store = new OwnedBrowserStore(root);
+        Assert.ThrowsAny<IOException>(() => new OwnedBrowserStore(root));
+        store.Dispose(); Assert.Throws<ObjectDisposedException>(()=>store.List());
+        using var next = new OwnedBrowserStore(root); Assert.Empty(next.List());
+    }
+    [Theory][InlineData("{")][InlineData("null")][InlineData("{\"Version\":99,\"Workspaces\":[]}")]
+    public void CorruptionFailsClosed(string value)
+    {
+        using(var store = new OwnedBrowserStore(root)) store.CreateWorkspace(Id(),"W");
+        var state=Path.Combine(root,"OwnedBrowser-v1","state.json"); File.WriteAllText(state,value);
+        Assert.Throws<InvalidDataException>(()=>new OwnedBrowserStore(root)); Assert.Equal(value,File.ReadAllText(state));
+    }
+    [Fact] public void OversizedStateFailsClosed()
+    {
+        using(var store=new OwnedBrowserStore(root)) { }
+        File.WriteAllText(Path.Combine(root,"OwnedBrowser-v1","state.json"),new string('x',OwnedBrowserPolicy.MaxStateBytes+1));
+        Assert.Throws<InvalidDataException>(()=>new OwnedBrowserStore(root));
+    }
+    [Fact] public void RemovalRequiresExplicitChoiceAndPreservesRetainedProfile()
+    {
+        using var store=new OwnedBrowserStore(root); var a=Id(); store.CreateWorkspace(a,"W");
+        var profile=store.GetProfileDirectory(a); File.WriteAllText(Path.Combine(profile,"cookie-fixture"),"synthetic");
+        Assert.Throws<ArgumentException>(()=>store.RemoveWorkspace(a,(ProfileRemoval)42));
+        store.RemoveWorkspace(a,ProfileRemoval.Keep); Assert.True(Directory.Exists(profile));
+        store.CreateWorkspace(a,"Restored"); store.RemoveWorkspace(a,ProfileRemoval.Delete); Assert.False(Directory.Exists(profile));
+    }
+    [Fact] public void ForeignProfileIsNeverAdoptedOrDeleted()
+    {
+        using var store=new OwnedBrowserStore(root); var id=Id();
+        var foreign=Path.Combine(root,"OwnedBrowser-v1","profiles",id); Directory.CreateDirectory(foreign);
+        var sentinel=Path.Combine(foreign,"user-data"); File.WriteAllText(sentinel,"keep");
+        Assert.Throws<InvalidOperationException>(()=>store.CreateWorkspace(id,"W")); Assert.Equal("keep",File.ReadAllText(sentinel));
+    }
+    [Fact] public void TraversalStorageAndForeignRootRejected()
+    {
+        Directory.CreateDirectory(root); var foreign=Path.Combine(root,"OwnedBrowser-v1"); Directory.CreateDirectory(foreign); File.WriteAllText(Path.Combine(foreign,"foreign"),"keep");
+        Assert.Throws<InvalidOperationException>(()=>new OwnedBrowserStore(root));
+        Assert.Throws<ArgumentException>(()=>new OwnedBrowserStore(Path.Combine(root,"..","escape")));
+    }
+    [Fact] public void JunctionInProfileCannotDeleteOutsideData()
+    {
+        using var store=new OwnedBrowserStore(root); var id=Id(); store.CreateWorkspace(id,"W");
+        var outside=Path.Combine(root,"outside"); Directory.CreateDirectory(outside); var sentinel=Path.Combine(outside,"keep"); File.WriteAllText(sentinel,"keep");
+        var link=Path.Combine(store.GetProfileDirectory(id),"linked");
+        if(OperatingSystem.IsWindows())
+        {
+            var p=System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo("cmd.exe",$"/c mklink /J \"{link}\" \"{outside}\""){CreateNoWindow=true,UseShellExecute=false,RedirectStandardOutput=true,RedirectStandardError=true})!;
+            p.WaitForExit(); Assert.Equal(0,p.ExitCode);
+        }
+        else Directory.CreateSymbolicLink(link,outside);
+        try { Assert.ThrowsAny<IOException>(()=>store.RemoveWorkspace(id,ProfileRemoval.Delete)); Assert.True(File.Exists(sentinel)); Assert.Single(store.List()); }
+        finally { Directory.Delete(link); }
+    }
+    [Theory]
+    [InlineData("{\"Version\":99,\"Version\":1,\"Workspaces\":[]}")]
+    [InlineData("{\"Version\":1,\"Workspaces\":[],\"Workspaces\":[]}")]
+    public void DuplicateJsonPropertiesFailClosed(string value)
+    {
+        using(var store=new OwnedBrowserStore(root)) { }
+        var path=Path.Combine(root,"OwnedBrowser-v1","state.json"); File.WriteAllText(path,value);
+        Assert.Throws<InvalidDataException>(()=>new OwnedBrowserStore(root)); Assert.Equal(value,File.ReadAllText(path));
+    }
+    [Fact] public void MissingStateIsNotSilentlyReset()
+    {
+        using(var store=new OwnedBrowserStore(root)) store.CreateWorkspace(Id(),"W");
+        File.Delete(Path.Combine(root,"OwnedBrowser-v1","state.json"));
+        Assert.Throws<InvalidDataException>(()=>new OwnedBrowserStore(root));
+    }
+    [Fact] public void InvalidInputsDoNotChangeState()
+    {
+        using var store=new OwnedBrowserStore(root); var id=Id(); store.CreateWorkspace(id,"W");
+        Assert.Throws<ArgumentException>(()=>store.CreateWorkspace(Id(),new string('x',101)));
+        Assert.Throws<ArgumentException>(()=>store.OpenTab(id,"javascript:void(0)"));
+        Assert.Throws<ArgumentException>(()=>store.OpenTab(id,"https://example.com/"+new string('x',4096)));
+        Assert.Single(store.List()); Assert.Empty(store.List().Single().Tabs);
+    }
+    [Fact] public void FailedPersistenceDoesNotPublishMutation()
+    {
+        using var store=new OwnedBrowserStore(root); var a=Id(); store.CreateWorkspace(a,"W");
+        var state=Path.Combine(root,"OwnedBrowser-v1","state.json"); var before=File.ReadAllText(state);
+        using(var held=new FileStream(state,FileMode.Open,FileAccess.Read,FileShare.Read))
+            Assert.True(Record.Exception(()=>store.OpenTab(a,"about:blank")) is IOException or UnauthorizedAccessException);
+        Assert.Empty(store.List().Single().Tabs); Assert.Equal(before,File.ReadAllText(state));
+    }
+}
