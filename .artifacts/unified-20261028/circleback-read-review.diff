+public sealed class CirclebackClientTests
+{
+ const string Meeting = """{"id":"m1","name":"Review","notes":"notes","privateNotes":"private","actionItems":[{"id":1,"title":"Follow up","status":"PENDING"}]}""";
+ sealed class Handler(Func<HttpRequestMessage,CancellationToken,Task<HttpResponseMessage>> send):HttpMessageHandler {protected override Task<HttpResponseMessage> SendAsync(HttpRequestMessage r,CancellationToken c)=>send(r,c);}
+ static HttpResponseMessage Json(string body,HttpStatusCode status=HttpStatusCode.OK)=>new(status){Content=new StringContent(body,Encoding.UTF8,"application/json")};
+ static CirclebackClient Client(Func<HttpRequestMessage,CancellationToken,Task<HttpResponseMessage>> send,int max=4194304)=>new(_=>ValueTask.FromResult<string?>("fixture-token"),new Handler(send),max);
+ [Fact] public async Task Typed_meeting_and_bearer_scope(){using var client=Client((r,c)=>{Assert.Equal(HttpMethod.Get,r.Method);Assert.Equal("https://circleback.ai/api/meeting/m1",r.RequestUri!.AbsoluteUri);Assert.Equal("Bearer",r.Headers.Authorization!.Scheme);Assert.Equal("fixture-token",r.Headers.Authorization.Parameter);Assert.Null(r.Content);return Task.FromResult(Json(Meeting));});var result=await client.GetMeetingAsync("m1");Assert.Equal("notes",result.Meeting.Notes);Assert.Equal("private",result.Meeting.PrivateNotes);Assert.Equal("Follow up",Assert.Single(result.Meeting.ActionItems!).Title);Assert.Equal("/api/meeting/m1",result.Source.Endpoint.AbsolutePath);}
+ [Fact] public async Task Transcript_seconds(){using var client=Client((r,c)=>{Assert.EndsWith("/meeting/m1/transcript",r.RequestUri!.AbsoluteUri);return Task.FromResult(Json("""[{"speaker":"Jane","text":"Hello","timestamp":4.56}]"""));});Assert.Equal(4.56,Assert.Single((await client.GetTranscriptAsync("m1")).Segments).Timestamp);}
+ [Fact] public async Task Opaque_explicit_pagination(){int calls=0;using var client=Client((r,c)=>{calls++;var response=Json("["+Meeting+"]");if(calls==1)response.Headers.TryAddWithoutValidation("Link","</api/meetings?cursor=a%2Fb%3D>; rel=\"next\"");else Assert.Equal("?cursor=a%2Fb%3D",r.RequestUri!.Query);return Task.FromResult(response);});var first=await client.ListMeetingsAsync();Assert.Equal(1,calls);Assert.Single(first.Meetings);Assert.NotNull(first.NextPage);await client.ListMeetingsAsync(first.NextPage);Assert.Equal(2,calls);}
