+using System.Net;
+using System.Net.Http.Headers;
+using System.Text.Json;
+using System.Text.RegularExpressions;
+namespace OpenClicky.Providers.Circleback;
+
+/// <summary>Read-only API. Injected handlers are trusted transports and must not follow redirects.</summary>
+public sealed class CirclebackClient : IDisposable
+{
+ private static readonly Uri Origin = new("https://circleback.ai");
+ private static readonly JsonSerializerOptions JsonOptions = new(JsonSerializerDefaults.Web) { MaxDepth = 32 };
+ private readonly Func<CancellationToken, ValueTask<string?>> tokenAccessor;
+ private readonly HttpClient http;
+ private readonly int maxBytes;
+ public CirclebackClient(Func<CancellationToken, ValueTask<string?>> tokenAccessor, HttpMessageHandler? handler = null, int maxResponseBytes = 4194304)
+ {
+  ArgumentNullException.ThrowIfNull(tokenAccessor);
+  if(maxResponseBytes < 1 || maxResponseBytes > 16777216) throw new ArgumentOutOfRangeException(nameof(maxResponseBytes));
+  // Reject potentially credential-forwarding transports rather than mutating caller settings.
+  if(handler is HttpClientHandler h && h.AllowAutoRedirect || handler is SocketsHttpHandler s && s.AllowAutoRedirect) throw new ArgumentException("Redirects must be disabled.", nameof(handler));
+  this.tokenAccessor=tokenAccessor; maxBytes=maxResponseBytes;
+  http=new HttpClient(handler ?? new SocketsHttpHandler { AllowAutoRedirect=false, UseCookies=false, MaxResponseHeadersLength=32 }, true) { Timeout=TimeSpan.FromSeconds(60) };
+ }
+ public async Task<CirclebackMeetingPage> ListMeetingsAsync(Uri? nextPage = null, CancellationToken cancellationToken = default)
+ {
+  var endpoint=nextPage ?? new Uri(Origin,"/api/meetings"); ValidatePage(endpoint);
+  var response=await ReadAsync<List<CirclebackMeeting>>(endpoint,cancellationToken);
+  if(response.Value.Count>10000) throw Error(CirclebackErrorKind.MalformedResponse);
+  foreach(var meeting in response.Value) ValidateMeeting(meeting);
+  return new(response.Value.AsReadOnly(),response.Next,new(endpoint,response.At));
+ }
+ public async Task<CirclebackMeetingResult> GetMeetingAsync(string meetingId, CancellationToken cancellationToken = default)
+ {
+  var endpoint=MeetingEndpoint(meetingId, false);var response=await ReadAsync<CirclebackMeeting>(endpoint,cancellationToken);
+  ValidateMeeting(response.Value);if(response.Value.Id!=meetingId) throw Error(CirclebackErrorKind.MalformedResponse);
+  return new(response.Value,new(endpoint,response.At));
+ }
+ public async Task<CirclebackTranscriptResult> GetTranscriptAsync(string meetingId, CancellationToken cancellationToken = default)
+ {
+  var endpoint=MeetingEndpoint(meetingId,true);var response=await ReadAsync<List<CirclebackSegment>>(endpoint,cancellationToken);
+  if(response.Value.Count>10000 || response.Value.Any(x=>x is null || x.Speaker is null || x.Text is null || !double.IsFinite(x.Timestamp) || x.Timestamp<0)) throw Error(CirclebackErrorKind.MalformedResponse);
+  return new(meetingId,response.Value.AsReadOnly(),new(endpoint,response.At));
+ }
+ private static Uri MeetingEndpoint(string id,bool transcript)
+ {
+  if(string.IsNullOrEmpty(id) || id.Length>256 || !id.All(c=>char.IsAsciiLetterOrDigit(c)||c=='_'||c=='-')) throw new ArgumentException("Invalid meeting ID.",nameof(id));
+  return new Uri(Origin,"/api/meeting/"+id+(transcript?"/transcript":""));
+ }
+ private static void ValidatePage(Uri uri)
+ {
+  if(!uri.IsAbsoluteUri || uri.Scheme!="https" || uri.IdnHost!="circleback.ai" || uri.Port!=443 || uri.UserInfo.Length!=0 || uri.Fragment.Length!=0 || uri.AbsolutePath!="/api/meetings" || uri.OriginalString.Length>8192) throw Error(CirclebackErrorKind.UnsafeEndpoint);
+ }
+ private static void ValidateMeeting(CirclebackMeeting m)
+ {
+  if(m is null || string.IsNullOrWhiteSpace(m.Id) || string.IsNullOrWhiteSpace(m.Name) || m.Duration is double d && (!double.IsFinite(d)||d<0) || m.ActionItems?.Count>10000 || m.Attendees?.Count>10000 || m.Tags?.Count>10000 || m.ActionItems?.Any(a=>a is null || a.Id<=0 || string.IsNullOrWhiteSpace(a.Title))==true) throw Error(CirclebackErrorKind.MalformedResponse);
+ }
+ private async Task<(T Value,Uri? Next,DateTimeOffset At)> ReadAsync<T>(Uri endpoint,CancellationToken ct) where T:class
+ {
+  ct.ThrowIfCancellationRequested();var token=await tokenAccessor(ct);ct.ThrowIfCancellationRequested();
+  if(string.IsNullOrWhiteSpace(token) || token.Length>8192 || token.Any(c=>c<33||c>126)) throw Error(CirclebackErrorKind.Revoked);
+  using var request=new HttpRequestMessage(HttpMethod.Get,endpoint);request.Headers.Authorization=new AuthenticationHeaderValue("Bearer",token);request.Headers.Accept.Add(new("application/json"));
+  try {
+   using var response=await http.SendAsync(request,HttpCompletionOption.ResponseHeadersRead,ct);
+   int status=(int)response.StatusCode;
+   if(status>=300 && status<400) throw new CirclebackException(CirclebackErrorKind.UnsafeEndpoint,response.StatusCode);
+   if(!response.IsSuccessStatusCode) {
+    TimeSpan? retry=response.Headers.RetryAfter?.Delta;
+    if(retry is null && response.Headers.RetryAfter?.Date is DateTimeOffset date) retry=date>DateTimeOffset.UtcNow?date-DateTimeOffset.UtcNow:TimeSpan.Zero;
+    throw new CirclebackException(status is 401 or 403?CirclebackErrorKind.Revoked:status==429?CirclebackErrorKind.RateLimited:status>=500?CirclebackErrorKind.Unavailable:CirclebackErrorKind.RequestFailed,response.StatusCode,status==429?retry:null);
+   }
+   if(response.Content.Headers.ContentLength>maxBytes) throw Error(CirclebackErrorKind.ResponseTooLarge);
+   await using var stream=await response.Content.ReadAsStreamAsync(ct);using var buffer=new MemoryStream();byte[] chunk=new byte[Math.Min(8192,maxBytes+1)];
+   int read;while((read=await stream.ReadAsync(chunk.AsMemory(0,Math.Min(chunk.Length,maxBytes-(int)buffer.Length+1)),ct))>0){if(buffer.Length+read>maxBytes) throw Error(CirclebackErrorKind.ResponseTooLarge);buffer.Write(chunk,0,read);}
+   T value;try {value=JsonSerializer.Deserialize<T>(buffer.GetBuffer().AsSpan(0,(int)buffer.Length),JsonOptions) ?? throw Error(CirclebackErrorKind.MalformedResponse);}catch(JsonException){throw Error(CirclebackErrorKind.MalformedResponse);}
+   Uri? next=null;
+   if(endpoint.AbsolutePath=="/api/meetings" && response.Headers.TryGetValues("Link",out var links)) {
+    var combined=string.Join(",",links);if(combined.Length>8192) throw Error(CirclebackErrorKind.UnsafeEndpoint);
+    foreach(Match match in Regex.Matches(combined,@"<([^>]+)>s*((?:;[^<]*)?)",RegexOptions.CultureInvariant,TimeSpan.FromMilliseconds(100))) {
+     if(!Regex.IsMatch(match.Groups[2].Value,"""(?:^|;)\s*rel\s*=\s*(?:"[^"]*\bnext\b[^"]*"|next)(?:\s*;|\s*,|\s*$)""",RegexOptions.IgnoreCase|RegexOptions.CultureInvariant,TimeSpan.FromMilliseconds(100))) continue;
+     if(next is not null || !Uri.TryCreate(endpoint,match.Groups[1].Value,out next)) throw Error(CirclebackErrorKind.UnsafeEndpoint);ValidatePage(next);
+    }
+   }
+   return(value,next,DateTimeOffset.UtcNow);
+  } catch(HttpRequestException){throw Error(CirclebackErrorKind.Unavailable);}catch(IOException){throw Error(CirclebackErrorKind.Unavailable);}catch(OperationCanceledException) when(!ct.IsCancellationRequested){throw Error(CirclebackErrorKind.Unavailable);}
+ }
+ private static CirclebackException Error(CirclebackErrorKind kind)=>new(kind);
+ public void Dispose()=>http.Dispose();
+}
