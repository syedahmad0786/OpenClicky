+using System.Net;
+namespace OpenClicky.Providers.Circleback;
+public enum CirclebackErrorKind { Revoked, RateLimited, Unavailable, UnsafeEndpoint, MalformedResponse, ResponseTooLarge, RequestFailed }
+public sealed class CirclebackException(CirclebackErrorKind kind, HttpStatusCode? statusCode = null, TimeSpan? retryAfter = null) : Exception($"Circleback request failed: {kind}.")
+{
+ public CirclebackErrorKind Kind { get; } = kind;
+ public HttpStatusCode? StatusCode { get; } = statusCode;
+ public TimeSpan? RetryAfter { get; } = retryAfter;
+}
+public sealed record CirclebackSource(Uri Endpoint, DateTimeOffset RetrievedAt);
+public sealed record CirclebackPerson(int? ProfileId, string? Name, string? Title, string? CompanyName, string? Email, bool? IsCalendarEventOrganizer, bool? IsCalendarInvitee);
+public sealed record CirclebackTag(int Id, string Name, string? Description);
+public sealed record CirclebackAction(int Id, string Title, string? Description, CirclebackPerson? Assignee, string? Status);
+public sealed record CirclebackMeeting(string Id, string Name, DateTimeOffset? CreatedAt, DateTimeOffset? UpdatedAt, double? Duration, string? Url, string? RecordingUrl, string? IcalUid, IReadOnlyList<CirclebackTag>? Tags, IReadOnlyList<CirclebackPerson>? Attendees, string? Notes, string? PrivateNotes, IReadOnlyList<CirclebackAction>? ActionItems);
+public sealed record CirclebackSegment(string Speaker, string Text, [property: System.Text.Json.Serialization.JsonRequired] double Timestamp);
+public sealed record CirclebackMeetingPage(IReadOnlyList<CirclebackMeeting> Meetings, Uri? NextPage, CirclebackSource Source);
+public sealed record CirclebackMeetingResult(CirclebackMeeting Meeting, CirclebackSource Source);
+public sealed record CirclebackTranscriptResult(string MeetingId, IReadOnlyList<CirclebackSegment> Segments, CirclebackSource Source);
