+ [Fact] public async Task Missing_token(){using var client=new CirclebackClient(_=>ValueTask.FromResult<string?>(null),new Handler((r,c)=>throw new Xunit.Sdk.XunitException("No send")));Assert.Equal(CirclebackErrorKind.Revoked,(await Assert.ThrowsAsync<CirclebackException>(()=>client.ListMeetingsAsync())).Kind);}
+ [Theory][InlineData("../x")][InlineData("x/y")][InlineData("x?x")][InlineData("")]
