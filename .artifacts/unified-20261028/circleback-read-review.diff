+ [Fact] public void Rejects_auto_redirect_transport(){Assert.Throws<ArgumentException>(()=>new CirclebackClient(_=>ValueTask.FromResult<string?>("fixture"),new HttpClientHandler{AllowAutoRedirect=true}));}
